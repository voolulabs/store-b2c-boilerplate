# Stack de homologação POS — copie para deploy/.env (gitignored) e preencha.
# Credenciais NUNCA vão para o repo. Gere secrets com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Secrets de sessão — OBRIGATÓRIOS: o compose recusa subir sem eles, porque o
# core não tem fallback em produção (boot falha com undefined) e assinar
# sessões com valor público é equivalente a não ter secret.
JWT_SECRET=
COOKIE_SECRET=

# Admin criado idempotentemente pelo one-shot ensure-admin a cada `up`.
MEDUSA_ADMIN_EMAIL=admin@homolog.local
MEDUSA_ADMIN_PASSWORD=

# Providers de terminal do plugin POS. POS_PAYMENTS_MANUAL=true sobe
# os providers manuais card/pix/cash/transfer (rede de segurança do caixa).
# POS_PAYMENTS_MP_TEST=true sobe o adapter Mercado Pago Point — deixe false
# sem credenciais sandbox preenchidas (guard T6: só serial SBX* com
# mpPointTestMode explícito; produção mantém a flag ausente).
POS_PAYMENTS_MANUAL=true
POS_PAYMENTS_MP_TEST=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# CORS para o app de caixa (medusa-pos/Tauri) e storefront opcional.
ADMIN_CORS=http://localhost:9000,http://localhost:1420,tauri://localhost,http://tauri.localhost,http://localhost:8000
AUTH_CORS=http://localhost:9000,http://localhost:1420,tauri://localhost,http://tauri.localhost,http://localhost:8000
STORE_CORS=http://localhost:8000
